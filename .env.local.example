# Supabase — pegue em Project Settings > API no painel do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Painel admin — senha simples e um segredo aleatório para assinar a sessão.
# Gere o segredo com: openssl rand -hex 32
ADMIN_PASSWORD=escolha-uma-senha-forte
ADMIN_SESSION_SECRET=gere-um-valor-aleatorio-longo
